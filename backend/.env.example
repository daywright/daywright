# Copy to .env and fill in. Never commit .env.

# Server
DAYWRIGHT_PORT=3000
RUST_LOG=info,daywright_api=debug

# Database (added in M1; not used by the skeleton yet)
# DATABASE_URL=postgres://daywright:daywright@localhost:5432/daywright

# Which implementation each capability uses: cloud or local.
DAYWRIGHT_STT=cloud
DAYWRIGHT_LLM=cloud
DAYWRIGHT_TTS=cloud

# Model tiers (see docs/architecture.md). Use the exact ids.
DAYWRIGHT_LLM_GATE_MODEL=claude-haiku-5-5
DAYWRIGHT_LLM_MAIN_MODEL=claude-opus-5-5

# Cloud provider keys (only the ones your config selects)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
SONIOX_API_KEY=

# Local provider endpoints (only when the matching capability is set to local)
# OLLAMA_URL=http://localhost:11434
# WHISPER_MODEL_PATH=/path/to/ggml-large-v3.bin
# PIPER_BIN=/path/to/piper
